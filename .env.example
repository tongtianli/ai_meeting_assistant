# Copy to .env and adjust. Never commit real secrets (PRD §9.3).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meeting_assistant
# 音频与中间产物根目录（MVP 本地磁盘）
DATA_DIR=./data
# ASR provider：mock（本地开发）；云 provider 接入后切换
ASR_PROVIDER=mock
# 鉴权（PRD §9.2）：生产环境必须改为强随机值（openssl rand -hex 32）
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_PASSWORD=dev-password
# LLM 路由模式：task_based（按任务独立路由）| legacy（回滚：全任务共用 LLM_PROVIDERS）
LLM_ROUTING_MODE=task_based
# legacy 模式顺序 / task_based 下任务路由全不可用时的回退（无 key 联调设为 mock）
LLM_PROVIDERS=gemini,glm
GEMINI_API_KEY=
GLM_API_KEY=
# 任务级路由（task_based；节点：glm_air / glm_flash / gemini / mock）——
# 高价值任务优先消耗 GLM-4.5-Air 赠送额度，轻量任务走免费 Flash，Gemini 灾备
# SUMMARY_MAP_PROVIDERS=glm_flash,glm_air,gemini
# SUMMARY_FINAL_PROVIDERS=glm_air,glm_flash,gemini
# SUMMARY_EDIT_PROVIDERS=glm_air,glm_flash,gemini
# QA_PROVIDERS=glm_flash,gemini,glm_air
# QUERY_REWRITE_PROVIDERS=glm_flash,gemini
# INTENT_CLASSIFY_PROVIDERS=glm_flash,gemini
# 模型名可覆盖；GLM_AIR/FLASH 型号上线前须经智谱控制台+真实调用确认。
# flash 默认沿用已验证的 glm-4-flash，确认支持后再显式切新版免费 Flash
# GEMINI_MODEL=gemini-3.5-flash
# GLM_MODEL=glm-4-flash          # legacy 模式的 glm 节点
# GLM_AIR_MODEL=glm-4.5-air
# GLM_FLASH_MODEL=glm-4-flash    # 验证后可切 glm-4.7-flash
# 资源包信息（Tech Design M4 §11/§12）：仅用于应用侧用量预警（/api/llm-usage/stats
# 与前端「模型用量」页），控制台余额是最终真值；按实际购买量覆盖
# GLM_AIR_GRANT_TOTAL_TOKENS=12000000
# GLM_GENERAL_GRANT_TOTAL_TOKENS=1996701
# GLM_GRANT_EXPIRES_AT=2026-10-10T08:40:18+08:00
# 纪要范例库 few-shot：每次摘要注入的范例条数与总字符预算
# SUMMARY_EXAMPLES_MAX_COUNT=3
# SUMMARY_EXAMPLES_MAX_CHARS=6000
# 转码前处理（远场/小音量优化；置空禁用）
# TRANSCODE_FILTERS=highpass=f=80,afftdn,loudnorm=I=-16:TP=-1.5:LRA=11
# FunASR VAD 阈值（越低越不易丢小音量语句；官方默认 0.6）
# 经验：paraformer 用 0.5（防漏），Fun-ASR-Nano 用 0.6+（防幻觉）
# FUNASR_SPEECH_NOISE_THRES=0.5
# VAD 单段最大毫秒数（限制 LLM 模型的幻觉面；官方默认 60000）
# FUNASR_VAD_MAX_SEGMENT_MS=30000
# FunASR 主模型（可切 LLM-based 的 FunAudioLLM/Fun-ASR-Nano-2512 做 A/B）
# FUNASR_MODEL=paraformer-zh
# 通义听悟（云 ASR；uv sync --extra tingwu；音频经 OSS 中转）
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# TINGWU_APP_KEY=
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OSS_BUCKET=
# 火山引擎 Seed ASR 2.0（大模型录音文件识别；base64 直传，无需 OSS）
# VOLC_APP_KEY=
# VOLC_ACCESS_KEY=
# VOLC_RESOURCE_ID=volc.bigasr.auc
# 声纹匹配等附加参数（JSON），如 {"voice_print_list": ["vp-xxx"]}
# SEEDASR_EXTRA_REQUEST=

# AI 问答 RAG（PRD Feature 5）；embedding 不可降级混用，单一 provider
EMBEDDING_PROVIDER=glm          # glm | gemini | mock
# GLM_EMBEDDING_MODEL=embedding-3
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# 问题命中说话人真名时，额外并入该说话人的片段数（说话人感知混合检索）
# QA_SPEAKER_TOP_K=6
