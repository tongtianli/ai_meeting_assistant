# Copy to .env and adjust. Never commit real secrets (PRD §9.3).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meeting_assistant
# 音频与中间产物根目录（MVP 本地磁盘）
DATA_DIR=./data
# ASR provider：mock（本地开发）；云 provider 接入后切换
ASR_PROVIDER=mock
# 鉴权（PRD §9.2）：生产环境必须改为强随机值（openssl rand -hex 32）
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_PASSWORD=dev-password
# LLM Router（按序尝试；无 key 联调可设为 mock）
LLM_PROVIDERS=gemini,glm
GEMINI_API_KEY=
GLM_API_KEY=
# 模型名可覆盖（默认 gemini-2.5-flash / glm-4-flash）
# GEMINI_MODEL=gemini-3.5-flash
# GLM_MODEL=glm-4-flash
